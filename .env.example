# ── Database ─────────────────────────────────────────────────────────────────
# MySQL connection string. Create the DB first:
#   CREATE DATABASE find_house_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:yourpassword@localhost:3306/find_house_db"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_strong_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Email (Nodemailer via Gmail App Password) ─────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use '*' to allow everything (dev-only, not safe in production).
# VS Code Live Server default: http://127.0.0.1:5500
# Vite default: http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5500

# ── Business rules ────────────────────────────────────────────────────────────
LISTING_FEE=100000

GROQ_API_KEY=your_groq_api_key_here
